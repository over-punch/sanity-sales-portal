      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "rollup": "^3.0.0",
      "rollup-plugin-typescript2": "^0.34.0",
      "typescript": "^5.0.0"
   },
   "peerDependencies": {
      "@sanity/ui": ">=2 <5",
      "react": "^18.0.0 || ^19.0.0",
